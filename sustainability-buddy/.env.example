# LiteLLM Gateway Configuration
# Copy this file to .env and fill in your actual values

# Your API key for Duke's LiteLLM Enterprise Edition gateway
VITE_LITELLM_API_KEY=your_api_key_here

# The base URL for Duke's LiteLLM Enterprise Edition gateway
# Example: https://litellm-gateway.duke.edu or https://api.duke.edu/litellm
VITE_LITELLM_GATEWAY_URL=https://your-duke-litellm-gateway-url.com

# The model to use (e.g., GPT 4.1 Mini, azure/gpt-4.1-nano, etc.)
# This should match the exact model name configured in your LiteLLM gateway
VITE_LITELLM_MODEL=GPT 4.1 Mini
